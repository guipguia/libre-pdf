// Cloudflare Workers static assets: serves dist/ as-is (no Worker code, no logs of visitors).
// Tool pages (/merge-pdf, …) are client-side routes, so unknown paths fall back to index.html.
{
  "name": "libre-pdf",
  "compatibility_date": "2026-10-19",
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
